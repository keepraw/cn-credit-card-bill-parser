.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime data. These folders may contain private statements,
# parsed transactions, SQLite databases, and review files.
data/*
output/*
processed/*
review_files/*
inbox/*
backups/*
logs/*

# Secrets and local configuration
.env
.env.*
*.key
*.pem
*.p12

# Databases and local caches
*.db
*.sqlite
*.sqlite3
*.parquet
*.pkl

# Statement/source files are sensitive by default.
*.eml
*.msg
*.pdf
*.html
*.htm
*.txt
*.csv
*.tsv
*.xls
*.xlsx

# --- Web app (local-first React front end) ---
# The blanket *.html rule above would hide the Vite entry point, so re-allow it.
!web/index.html

node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/blob-report/
web/.vite/

# Real statements must never be committed, including anything placed under web/.
web/**/*.eml
web/**/*.msg
web/**/*.pdf
web/**/*.PDF
web/**/*.html
!web/index.html
web/**/*.txt
web/**/*.csv
web/**/*.tsv
web/**/*.xlsx
web/**/*.db
web/**/*.sqlite*

# Playwright / test scratch space
.playwright/
*.local

# Local audit reports may contain financial data; do not commit them.
reports/*.json


